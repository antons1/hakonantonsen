---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/substack";
import { photos } from "../lib/photos";

const posts = (await getPosts()).slice(0, 3);
const highlights = photos.slice(0, 3);
---

<Base>
  <p class="intro">
    Hi — I'm Håkon. This is where I collect the things I make and want to
    share: writing, photography, and eventually drawings and paintings.
    <!-- PLACEHOLDER INTRO — Håkon: replace with your own words. -->
  </p>

  <section>
    <h2><a href="/photos/">Photography</a></h2>
    <a class="tiles" href="/photos/">
      {highlights.map((photo) => (
        <img
          class="tile"
          src={photo.src}
          alt={photo.description ?? ""}
          loading="lazy"
          decoding="async"
        />
      ))}
    </a>
    <p class="hint"><a href="/photos/">All photos →</a></p>
  </section>

  <section>
    <h2><a href="/writing/">Recent writing</a></h2>
    <PostList posts={posts} />
    <p class="hint"><a href="/writing/">All writing →</a></p>
  </section>
</Base>

<style>
  .intro {
    font-size: 1.2rem;
    line-height: 1.6;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .tile {
    aspect-ratio: 3 / 2;
    width: 100%;
    object-fit: cover;
    background: var(--tile);
    border-radius: 4px;
  }

  .hint {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.85rem;
  }
</style>
